# VitaStack / BioTask - Environment Variables Example
SECRET_KEY=django-insecure-vitastack-bio-task-secret-key-change-in-prod-2026!
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.herokuapp.com

# PostgreSQL Connection
DATABASE_URL=postgres://vitastack_user:your_secure_password_here@127.0.0.1:5432/vitastack_db
DB_NAME=vitastack_db
DB_USER=vitastack_user
DB_PASSWORD=your_secure_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
