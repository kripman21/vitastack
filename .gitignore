# ==============================================================================
# .gitignore - BioCluster / VitaStack System
# ==============================================================================

# Entornos virtuales de Python
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Archivos compilados y bytecode de Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Base de datos local SQLite / dumps
*.sqlite3
*.db
*.dump

# Entorno y Secretos
.env
.env.local
.env.*.local
!.env.example

# Logs y depuración
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend (prototipo)
node_modules/
prototipo/node_modules/
prototipo/dist/
prototipo/build/
prototipo/coverage/

# IDEs, editores y sistema operativo
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Directorio de documentación interna y reportes de depuración (Solictado ignorar)
docs/

# Archivos temporales de empaquetado
*.egg-info/
dist/
build/
eggs/
.eggs/
